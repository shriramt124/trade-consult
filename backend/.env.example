# --- Core ---
PROJECT_NAME=AlphaInsiight API
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Dev default is SQLite. For production use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trade_consult
DATABASE_URL=sqlite:///./trade_consult.db

# --- CORS (comma separated) ---
BACKEND_CORS_ORIGINS=http://localhost:3010

# --- Admin console login (email + password; the only login this app has) ---
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@alphainsiight.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- SMS (MSG91) — used to alert subscribers about new calls ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- WhatsApp Business API ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
