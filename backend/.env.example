# --- Core ---
PROJECT_NAME=AlphaInsiight API
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Dev default is SQLite. For production use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trade_consult
DATABASE_URL=sqlite:///./trade_consult.db

# --- CORS (comma separated) ---
BACKEND_CORS_ORIGINS=http://localhost:3010

# --- Auth ---
# When true, the OTP is returned in the API response (dev only!)
DEV_RETURN_OTP=true
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
ADMIN_PHONE=9999999999

# --- SMS (MSG91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- WhatsApp Business API ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
